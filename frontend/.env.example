APP_MODE=development
LOG_LEVEL=info
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOAT_RPC_URL=https://rpc.goat.network
NEXT_PUBLIC_GOAT_EXPLORER_URL=https://explorer.goat.network

# Signed wallet sessions are required for wallet-scoped strategy and auto-mode
# APIs. Non-production enables them automatically; production must opt in.
ALLOW_WALLET_SESSION_COOKIE=0
WALLET_SESSION_COOKIE_SECRET=

# V3 auto-mode contract evidence. Keep verification status unverified until an
# independent deployment verifier has checked bytecode, network, and version.
AUTO_MODE_CONTRACT_ADDRESS=
AUTO_MODE_CONTRACT_NETWORK=
AUTO_MODE_CONTRACT_POLICY_VERSION=
AUTO_MODE_CONTRACT_VERIFICATION_STATUS=unverified
AUTO_MODE_CONTRACT_VERIFICATION_ID=
AUTO_MODE_CONTRACT_VERIFIED_AT=
AUTO_MODE_VERIFIED_CONTRACT_ADDRESS=
AUTO_MODE_VERIFIED_CONTRACT_NETWORK=
AUTO_MODE_VERIFIED_CONTRACT_VERSION=
AUTO_MODE_CONTRACT_VERIFICATION_FAILURE=

# Public Stellar network configuration. Testnet is the safe default until all
# production gates pass.
NEXT_PUBLIC_STELLAR_NETWORK=stellar-testnet
NEXT_PUBLIC_STELLAR_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_TESTNET_RPC_FALLBACK_URLS=https://soroban-rpc.testnet.stellar.gateway.fm
NEXT_PUBLIC_STELLAR_TESTNET_DATA_API_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_TESTNET_DATA_API_FALLBACK_URLS=
NEXT_PUBLIC_STELLAR_TESTNET_EXPLORER_URL=https://stellar.expert/explorer/testnet
NEXT_PUBLIC_STELLAR_PUBNET_RPC_URL=https://mainnet.sorobanrpc.com
NEXT_PUBLIC_STELLAR_PUBNET_RPC_FALLBACK_URLS=https://soroban-rpc.mainnet.stellar.gateway.fm
NEXT_PUBLIC_STELLAR_PUBNET_DATA_API_URL=https://horizon.stellar.org
NEXT_PUBLIC_STELLAR_PUBNET_DATA_API_FALLBACK_URLS=https://horizon.stellar.lobstr.co
NEXT_PUBLIC_STELLAR_PUBNET_EXPLORER_URL=https://stellar.expert/explorer/public
NEXT_PUBLIC_STELLAR_RISK_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_STELLAR_TESTNET_RISK_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_STELLAR_PUBNET_RISK_REGISTRY_CONTRACT_ID=
STELLAR_TESTNET_RISK_REGISTRY_ID=
STELLAR_PUBNET_RISK_REGISTRY_ID=

# Server-only storage. Never expose SERVICE_ROLE keys with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only portfolio providers.
# Recommended: multi-chain wallet portfolio with balances, logos, and USD quotes.
GOLDRUSH_API_KEY=
COVALENT_API_KEY=
GOLDRUSH_CHAINS=eth-mainnet,base-mainnet,arbitrum-mainnet,bsc-mainnet,linea-mainnet,matic-mainnet,optimism-mainnet

# Optional server-only fallback: single-chain ERC-20 discovery with Alchemy.
# Supported values for PORTFOLIO_CHAIN: ethereum, base, arbitrum
ALCHEMY_API_KEY=
PORTFOLIO_CHAIN=

# Server-only RPC/provider config.
GOAT_RPC_URL=https://rpc.goat.network
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_RPC_FALLBACK_URLS=https://soroban-rpc.testnet.stellar.gateway.fm
STELLAR_DATA_API_URL=https://horizon-testnet.stellar.org
STELLAR_DATA_API_FALLBACK_URLS=
STELLAR_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_TESTNET_RPC_FALLBACK_URLS=https://soroban-rpc.testnet.stellar.gateway.fm
STELLAR_PUBNET_RPC_URL=https://mainnet.sorobanrpc.com
STELLAR_PUBNET_RPC_FALLBACK_URLS=https://soroban-rpc.mainnet.stellar.gateway.fm
STELLAR_TESTNET_DATA_API_URL=https://horizon-testnet.stellar.org
STELLAR_TESTNET_DATA_API_FALLBACK_URLS=
STELLAR_PUBNET_DATA_API_URL=https://horizon.stellar.org
STELLAR_PUBNET_DATA_API_FALLBACK_URLS=https://horizon.stellar.lobstr.co

# Bounded provider retry/circuit policy. Values outside documented ranges are
# ignored in favor of safe defaults; failover never crosses a network identity.
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_OPEN_MS=30000
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BUDGET_MS=20000

# Inbound API rate limiting. Middleware applies per-route policies before handlers.
# Use Redis REST in production so limits hold across instances.
RATE_LIMIT_ENABLED=1
RATE_LIMIT_KEY_SECRET=
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional trusted SAC/SEP-41 registry. Unknown prices must be omitted, not set
# to zero. Keep this server-only because it controls trusted portfolio metadata.
# Example: [{"network":"stellar-testnet","kind":"sep41","contractId":"C...","symbol":"TOKEN","name":"Token","decimals":7,"verified":true,"priceUsd":1,"priceSource":"trusted_registry"}]
STELLAR_PORTFOLIO_TOKENS_JSON=
# Either provide a manually generated access token:
GOPLUS_API_KEY=
# Or provide app credentials; the server will request and cache access tokens:
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# Server-only x402 premium deep scan config. Production uses Base mainnet and
# the authenticated CDP facilitator. Never commit real CDP credentials.
X402_PAY_TO=0x3ED3E93047b4bCF2e6Ab0744Db08a132d0c97D7d
X402_PRICE_USD=\$0.99
X402_NETWORK=eip155:8453
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
X402_ASSET=USDC
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional server-only social providers. Add one later when Social Agent gets
# live engagement metrics.
X_BEARER_TOKEN=
APIFY_TOKEN=
TAVILY_API_KEY=
SOCIAL_DATA_PROVIDER_URL=

# Server-only Stellar x402 config. Testnet is the safe default. Pubnet is
# fail-closed: even when X402_STELLAR_ENABLED=1 you must also set
# X402_STELLAR_PUBNET_ENABLED=1 and a valid pubnet payTo before pubnet
# x402 payments are advertised. The USDC contract defaults to the
# well-known Centre-issued SEP-41 contracts if left unset.
X402_STELLAR_ENABLED=0
X402_STELLAR_PAY_TO=
X402_STELLAR_USDC_CONTRACT=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
X402_STELLAR_PUBNET_ENABLED=0
X402_STELLAR_PUBNET_PAY_TO=
X402_STELLAR_PUBNET_USDC_CONTRACT=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75

# Feature flags (server-side capability gates). Values: "on", "off", or
# "rollout:<0-100>". Dangerous capabilities default OFF when unset.
# Read-only token scan (safe default: on).
FEATURE_SCAN_TOKEN=on
# Execution: approval-only preview, submission, and auto-mode authorization.
FEATURE_EXECUTE_PREPARE=on
FEATURE_EXECUTE_SUBMIT=off
FEATURE_AUTO_MODE_AUTHORIZATION=off
# Payment-gated Stellar deep scan.
FEATURE_X402_STELLAR_DEEP_SCAN=off
# Optional alert delivery adapters (server-only). Never commit real tokens,
# webhook URLs, chat IDs, or email recipient identifiers.
# Email uses a signed generic webhook (HMAC-SHA256 over timestamp.body).
ALERT_EMAIL_WEBHOOK_URL=
ALERT_EMAIL_WEBHOOK_SECRET=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_DISCORD_WEBHOOK_URL=
# Chaos hook for fixtures/staging: comma-separated channels forced to fail.
# ALERT_FORCE_FAIL_CHANNELS=email,telegram
# Test-only: set ALERT_DELIVERY_BACKOFF_MS=0 to skip retry sleeps.
# ALERT_DELIVERY_BACKOFF_MS=0
DATABASE_URL=postgres://postgres:postgres@localhost:5432/golden_raccoon

# --- Stellar pubnet readiness gate (issue #149) ---------------------------
# Pubnet moves real user funds, so it is refused unless every condition below
# verifies at runtime. These are the governance-approved values a release
# review signed off on; a missing value keeps the gate closed rather than
# being treated as satisfied. Testnet deployments need none of them.
#
# SHA-256 hex of the reviewed risk-registry contract WASM.
STELLAR_PUBNET_APPROVED_REGISTRY_WASM_HASH=
# The contract addresses governance approved.
STELLAR_PUBNET_APPROVED_REGISTRY_ID=
STELLAR_PUBNET_APPROVED_POLICY_ID=
# The policy contract the app will actually consult.
STELLAR_PUBNET_POLICY_CONTRACT_ID=
# Where pubnet x402 payments must settle, and in which asset.
STELLAR_PUBNET_APPROVED_X402_PAY_TO=
STELLAR_PUBNET_APPROVED_USDC_CONTRACT=
# HTTPS origin of the approved settlement facilitator.
STELLAR_PUBNET_APPROVED_FACILITATOR_ORIGIN=
# Ledgers of drift tolerated between independent RPC providers. Default 5.
STELLAR_PUBNET_RPC_LEDGER_TOLERANCE=
